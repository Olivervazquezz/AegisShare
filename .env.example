# AegisShare — Environment Variables
# Copy this file to `.env` and fill in real values before deploying.

# Secret key used to sign JWT tokens. Generate a strong random string:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
AEGIS_SECRET_KEY=change-me-in-production

# JWT token lifetime in minutes (default: 30)
AEGIS_TOKEN_EXPIRE_MINUTES=30

# Database URL (SQLite for local dev, change for production)
DATABASE_URL=sqlite:///./sql_app_dev.db
